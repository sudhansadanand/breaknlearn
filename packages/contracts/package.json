{
  "name": "@bnl/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frozen BreakNLearn v1 contracts: Zod schemas, OpenAPI 3.1, telemetry JSON Schema, canonical catalog constants.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.yaml": "./openapi/openapi.yaml",
    "./learning-event-v1.schema.json": "./schemas/learning-event-v1.schema.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.12.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "yaml": "2.8.1"
  }
}
