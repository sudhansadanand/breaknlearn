{
  "name": "@bnl/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The only database entry point for request code: per-request transaction with SET LOCAL ROLE + RLS context.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --dir test/unit",
    "test:integration": "node ../../scripts/db/test-db.mjs -- vitest run --dir test/integration --no-file-parallelism"
  },
  "dependencies": {
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@bnl/contracts": "workspace:*"
  }
}
