{
  "name": "@bnl/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adult/admin portal (/admin) and BFF API (/api/v1) on the same origin as the student app (ADR-0006).",
  "scripts": {
    "copy-student": "node scripts/copy-student.mjs",
    "dev": "node scripts/copy-student.mjs && next dev",
    "build": "node scripts/copy-student.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude \"test/integration/**\"",
    "test:served": "node scripts/verify-student-served.mjs",
    "test:integration": "node ../../scripts/db/test-db.mjs -- vitest run test/integration --no-file-parallelism"
  },
  "dependencies": {
    "@bnl/auth": "workspace:*",
    "@bnl/contracts": "workspace:*",
    "@bnl/student-progress": "workspace:*",
    "@bnl/telemetry": "workspace:*",
    "next": "15.5.6",
    "postgres": "3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76",
    "@bnl/db": "workspace:*",
    "@bnl/curriculum": "workspace:*",
    "@bnl/lesson-engine": "workspace:*",
    "@bnl/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9"
  }
}
