# BreakNLearn environment template. Copy to .env.local for local dev.
# NEVER commit real values. Production values live in Vercel/Supabase secret stores only.

# --- Public (safe in browser bundles) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
APP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3000

# --- Server only (never NEXT_PUBLIC_, never shipped to the student bundle) ---
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DEVICE_TOKEN_SIGNING_SECRET=replace-with-32+-random-bytes-base64
# Optional HS256 Supabase JWT secret; when absent the project JWKS is used.
SUPABASE_JWT_SECRET=
# Background jobs (session aggregation, scoring, retention purge) use this login.
BNL_JOB_DB_URL=postgresql://bnl_app:replace-me@127.0.0.1:54322/postgres
# Request-path DB login (role bnl_app; can only act through withDbContext role switching).
BNL_APP_DB_URL=postgresql://bnl_app:replace-me@127.0.0.1:54322/postgres
BNL_DB_PREPARE=false
BNL_DB_POOL_MAX=5

# --- Object storage for school syllabus uploads. "supabase" when SUPABASE_URL+service key are set. ---
BNL_STORAGE_DRIVER=local
# Must be an absolute path; defaults to <tmpdir>/bnl-local-storage when unset.
BNL_LOCAL_STORAGE_DIR=
# Local storage is refused in production unless explicitly allowed (never for real families).
BNL_ALLOW_LOCAL_STORAGE=false

# --- Local development only. Refused when NODE_ENV/VERCEL_ENV=production. ---
BNL_DEV_AUTH=false
BNL_DEV_AUTH_PASSWORD=
# Start the dev users with the forced-password-change flag ("true" or comma-separated synthetic emails).
BNL_DEV_AUTH_MUST_CHANGE=false

# --- Limits and policy (defaults chosen pending owner decision, see IMPLEMENTATION_STATUS.md) ---
IMPORT_MAX_MB=20
IMPORT_SIGNED_URL_TTL_SECONDS=60
# Curriculum-to-lesson suggestion confidence (0..1); below this a node is left unmatched for review.
IMPORT_SUGGEST_THRESHOLD=0.2
TELEMETRY_BATCH_MAX=100
# Retention (owner default pending confirmation): raw telemetry 90 days, aggregates ~13 months.
RETENTION_RAW_TELEMETRY_DAYS=90
RETENTION_AGGREGATE_DAYS=395
HOUSEHOLD_DEFAULT_TZ=Asia/Kolkata

# --- Feature flags (all off until their milestone passes its gate) ---
FEATURE_PAIRING=false
FEATURE_TELEMETRY=false
FEATURE_CATALOG_API=false
FEATURE_ASSESSMENTS=false
FEATURE_SCORES=false
# Student TV runtime switches served by GET /api/v1/student/config.
FEATURE_STUDENT_PAIRED=false
# Set to false to unregister the student service worker on every TV (kill switch).
FEATURE_STUDENT_SW=true
